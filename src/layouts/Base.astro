---
import '../styles/global.css';
interface Props {
  title: string;
  fullTitle?: string;
  description?: string;
  path?: string;
}
const { title, fullTitle, description = 'AI-led automation consulting for Google Workspace and Microsoft 365. Built as a prototype. Shipped to production.', path = '' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle ?? `${title} · prototypes.design`}</title>
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Prototypes by Design",
    "url": "https://prototypes.design",
    "description": "AI-led automation consulting for Google Workspace and Microsoft 365. Working prototypes that ship to production.",
    "areaServed": "Worldwide",
    "serviceType": ["Google Workspace Automation", "Microsoft 365 Automation", "AI-led Process Automation"],
    "provider": {
      "@type": "Organization",
      "name": "NovoUp Technologies",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Pune",
        "addressCountry": "IN"
      },
      "url": "https://novoup.com"
    }
  })}</script>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={fullTitle ?? `${title} · prototypes.design`} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="prototypes.design" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
