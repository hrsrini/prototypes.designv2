---
export const prerender = true;
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import CapabilityCard from '../components/CapabilityCard.astro';
import StackBadge from '../components/StackBadge.astro';

const capabilities = [
  {
    title: 'Copilot Studio Orchestration',
    description: 'Custom copilots route requests, extract intent, and trigger downstream flows via Teams. Natural-language intake with structured output. No new user-facing systems to learn.'
  },
  {
    title: 'Power Automate Governance',
    description: 'All flows documented, versioned, and owned. Run history surfaced via Dataverse queries. Failed flows alert the responsible team, not a generic mailbox. Governance built in from the start.'
  },
  {
    title: 'AI Builder Integration',
    description: 'Form processing, document classification, and entity extraction using AI Builder models. Output is structured data in Dataverse, not unstructured text in an email. No third-party AI services.'
  },
  {
    title: 'SharePoint as the Source of Truth',
    description: 'Process artefacts, templates, and outputs stored in governed SharePoint libraries. Version history and permission structure aligned with existing IT governance. Nothing stored outside the tenant.'
  },
  {
    title: 'Teams-Native User Experience',
    description: 'All workflow interactions happen inside Teams. Adaptive cards for approvals. Bot responses for status queries. No context switching to external tools. Adoption is native, not trained.'
  },
  {
    title: 'Exception-Only Human Gates',
    description: 'Routine items processed automatically with a logged rationale. Exceptions and high-risk items escalated with an AI-prepared briefing. Human effort concentrated where it creates measurable value.'
  },
  {
    title: 'Dataverse Audit Logging',
    description: 'Every workflow step, decision, and outcome recorded in Dataverse with timestamp and actor. Audit-ready reports generated on demand. Compliance documentation is a query, not a project.'
  }
];
---

<Base title="For Enterprise" description="Automation built inside your Microsoft 365 tenant using Copilot Studio, Power Automate, and AI Builder. No new vendors. No shadow IT.">
  <NavBar path="/enterprise" />

  <main>
    <!-- Hero -->
    <section class="hero" style="background: var(--bg-page);">
      <div class="container">
        <span class="eyebrow">For Enterprise · Microsoft 365 tenants</span>
        <h1>Microsoft 365 automation consulting for <em>enterprise workflows</em></h1>
        <p class="hero-sub">No third-party platforms. No new vendors. Automation that runs inside the tools your enterprise already licences and governs — Copilot Studio, Power Automate, AI Builder.</p>
        <div class="hero-actions">
          <a href="/smb" class="btn btn-primary">For Google Workspace →</a>
          <a href="/enterprise" class="btn btn-outline">For Microsoft 365 →</a>
          <a href="/contact#contact-form-section" class="btn btn-outline">Get in touch →</a>
          <a href="https://calendly.com/hrsrini/i-need-to-know-more-about-automation" class="btn btn-dark">Book a meeting →</a>
        </div>
      </div>
    </section>

    <!-- Case Studies -->
    <section class="section section-numbered" data-section-num="01">
      <div class="container">
        <span class="eyebrow">In Practice</span>
        <h2>Automation patterns that have shipped</h2>
        <p class="section-sub">Every case below is a live pattern — built, tested, and running in a real environment. Click any card to read the full case.</p>
        <div class="cs-grid" style="margin-top: 2.5rem;">

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 01 · Communication Operations</span>
              <h3 class="cs-headline">AI email triage that routes without reading everything</h3>
              <p class="cs-synopsis">High-volume inboxes classified, prioritised, and routed automatically — before a human opens a single message.</p>
              <div class="cs-tags">
                <span class="cs-tag">Outlook</span>
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">AI Builder</span>
                <span class="cs-tag">Claude API</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Enterprise inboxes are not manageable at volume. A shared mailbox that receives hundreds of messages per day cannot be triaged by a human at the pace it arrives. Messages get missed. Priority items sit next to noise. Response times suffer because the sorting is manual.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>Every inbound message passed to an AI classification layer on arrival</li>
                  <li>Classification assigns category, priority, and routing destination</li>
                  <li>High-priority items flagged and surfaced immediately — not buried in arrival order</li>
                  <li>Routine queries auto-responded with templated replies — no human required</li>
                  <li>Escalation items routed to named owners with full context attached</li>
                  <li>Unclassified items held in a review queue — nothing silently dropped</li>
                  <li>Audit log written for every routing decision — reviewable, correctable</li>
                </ul>
                <p class="cs-pull">The inbox problem is not a volume problem. It's a classification problem. Classification is a job for a system.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your team manages a shared mailbox at scale and the routing is currently manual — or the response time is suffering because triage takes too long — this is the operational layer that changes that.</p>
              </div>
            </div>
          </div>

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 02 · Document Intelligence</span>
              <h3 class="cs-headline">Contracts read, extracted, and checked before anyone opens them</h3>
              <p class="cs-synopsis">Incoming documents processed automatically — key fields extracted, obligations flagged, exceptions surfaced.</p>
              <div class="cs-tags">
                <span class="cs-tag">SharePoint</span>
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">AI Builder</span>
                <span class="cs-tag">Claude API</span>
                <span class="cs-tag">Outlook</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Enterprises receive documents that require extraction and review at volume. Contracts. Certificates. Applications. Submissions. Each one arrives, gets opened by someone, gets reviewed manually, gets key fields noted somewhere. The extraction is repetitive. The review is inconsistent. The errors are invisible until they're not.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>Document arrives in SharePoint or Outlook — trigger fires automatically</li>
                  <li>AI layer extracts defined fields: parties, dates, values, obligations, special conditions</li>
                  <li>Extracted data written to a structured record — not stored in the document itself</li>
                  <li>Consistency check run against expected values or prior records</li>
                  <li>Exceptions flagged with the specific field and the discrepancy noted</li>
                  <li>Summary generated for human reviewer — what was found, what needs attention</li>
                  <li>Original document linked from the record — full traceability</li>
                  <li>Review queue updated — the human sees only the items that need a decision</li>
                </ul>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your team processes incoming documents manually — extracting fields, checking values, flagging exceptions — this reduces that to review and decision. The extraction and the first-pass check run automatically.</p>
              </div>
            </div>
          </div>

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 03 · Report Automation</span>
              <h3 class="cs-headline">Management reports that write themselves from live data</h3>
              <p class="cs-synopsis">Scheduled reports generated from live data sources — formatted, distributed, and archived without manual assembly.</p>
              <div class="cs-tags">
                <span class="cs-tag">SharePoint</span>
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">Excel</span>
                <span class="cs-tag">Dataverse</span>
                <span class="cs-tag">Outlook</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Every enterprise produces recurring management reports. The data exists. The format is defined. The distribution list is known. And yet someone spends hours every period pulling data from multiple sources, formatting it, and sending it. The process is mechanical. The errors are human.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>Data pulled from defined sources on trigger — SharePoint lists, Excel tables, Dataverse records</li>
                  <li>Calculations run automatically — no manual formula application</li>
                  <li>Report formatted to the agreed template — headers, sections, figures, all resolved from data</li>
                  <li>Narrative summary generated by AI where required — context added, not just numbers</li>
                  <li>Document produced and stored in SharePoint — version-controlled, findable</li>
                  <li>Distribution triggered on generation — the right recipients get it without a person sending it</li>
                  <li>Failure alert built in — if the data source is unavailable, the right person is notified before the report is due</li>
                </ul>
                <p class="cs-pull">If the report is the same process every time, it should not require a person every time.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your team produces recurring reports that require data assembly from multiple sources — and the assembly is currently manual — this takes that work off the schedule permanently.</p>
              </div>
            </div>
          </div>

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 04 · Onboarding Automation</span>
              <h3 class="cs-headline">New joiner onboarding that runs without an HR ticket</h3>
              <p class="cs-synopsis">Provisioning, communication, and checklist completion triggered automatically on hire confirmation.</p>
              <div class="cs-tags">
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">SharePoint</span>
                <span class="cs-tag">Outlook</span>
                <span class="cs-tag">Teams</span>
                <span class="cs-tag">Azure AD</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Enterprise onboarding involves a predictable set of tasks that are consistently done inconsistently. Access provisioning. Equipment requests. Introductory communications. Checklist items. Assigned buddies. Each one requires a person to remember to do it at the right time for the right person. When volume increases, the gaps appear.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>Trigger on HRIS record creation or hire confirmation in SharePoint</li>
                  <li>Provisioning requests generated and routed automatically — access, equipment, accounts</li>
                  <li>Welcome communication sent on day one trigger — personalised, role-specific, without manual drafting</li>
                  <li>Onboarding checklist created in SharePoint for the new joiner and their manager</li>
                  <li>Buddy or peer assigned from a rotation list — no manual coordination</li>
                  <li>30/60/90 day check-in reminders created in calendar automatically</li>
                  <li>Status dashboard for HR — all active onboardings, current stage, overdue items visible</li>
                </ul>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your onboarding process relies on a checklist that someone has to remember to work through — or on HR manually triggering each step — this makes the process self-executing. The human judgement steps (decisions, conversations) stay human. The coordination steps don't.</p>
              </div>
            </div>
          </div>

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 05 · Compliance Automation</span>
              <h3 class="cs-headline">Compliance monitoring that surfaces exceptions before they become incidents</h3>
              <p class="cs-synopsis">Policy checks run automatically against live data — exceptions flagged, escalated, and tracked without manual review.</p>
              <div class="cs-tags">
                <span class="cs-tag">SharePoint</span>
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">Dataverse</span>
                <span class="cs-tag">Outlook</span>
                <span class="cs-tag">Teams</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Compliance monitoring in an enterprise is a continuous process that is frequently done as a periodic one. By the time the monthly or quarterly review happens, the exception has already occurred. The audit trail is incomplete. The escalation is reactive. The finding is a surprise.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>Policy rules defined as structured checks in Dataverse</li>
                  <li>Checks run on a schedule against live records — daily or on data change</li>
                  <li>Exceptions identified at the record level — not at the aggregate level</li>
                  <li>Severity classification applied automatically — not all exceptions require the same response</li>
                  <li>Escalation triggered immediately on high-severity exception — not at the next review meeting</li>
                  <li>Full audit trail written — every check, every result, every escalation, timestamped</li>
                  <li>Summary report generated for compliance owner — what was checked, what was found, what was escalated</li>
                  <li>Dashboard for ongoing visibility — exception rate by category, by period, by business unit</li>
                </ul>
                <p class="cs-pull">Compliance monitoring that runs weekly is not compliance monitoring. It's compliance reporting. The monitoring has to be continuous.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your compliance process involves periodic manual review — and exceptions are discovered after the fact — this moves the detection point earlier. Continuous monitoring does not eliminate exceptions. It eliminates the lag between occurrence and discovery.</p>
              </div>
            </div>
          </div>

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 06 · Knowledge Management</span>
              <h3 class="cs-headline">Institutional knowledge that answers questions automatically</h3>
              <p class="cs-synopsis">Internal knowledge base connected to a conversational interface — accurate answers without search and without tickets.</p>
              <div class="cs-tags">
                <span class="cs-tag">SharePoint</span>
                <span class="cs-tag">Copilot Studio</span>
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">Teams</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Enterprise knowledge lives in SharePoint. Nobody uses SharePoint to search. They ask a colleague, raise a ticket, or send an email. The colleague answers from memory. The memory is sometimes wrong. The ticket takes three days. The email gets lost. The knowledge exists. The access is broken.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>SharePoint content indexed as the knowledge source — policies, procedures, FAQs, guides</li>
                  <li>Copilot Studio agent connected to the index — answers questions from the content, not from training data</li>
                  <li>Response includes source citation — the specific document and section, not a generated summary</li>
                  <li>Confidence threshold enforced — low-confidence answers escalate to a human, not silently wrong</li>
                  <li>Unanswered questions logged — gaps in the knowledge base identified automatically</li>
                  <li>Content freshness check on a schedule — outdated documents flagged for review</li>
                  <li>Deployed in Teams — where the questions are already being asked</li>
                </ul>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your team is answering the same operational questions repeatedly — by email, by ticket, by message — and the answers exist in a document somewhere, this connects the question to the document. The knowledge team's time goes to maintaining and improving content, not to answering the same question for the 40th time.</p>
              </div>
            </div>
          </div>

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 07 · Procurement Automation</span>
              <h3 class="cs-headline">Purchase requests that route, approve, and close without chasing</h3>
              <p class="cs-synopsis">End-to-end procurement workflow with structured intake, role-based approval, and automatic PO generation.</p>
              <div class="cs-tags">
                <span class="cs-tag">SharePoint</span>
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">Outlook</span>
                <span class="cs-tag">Dataverse</span>
                <span class="cs-tag">Teams</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Enterprise procurement workflows fail at the coordination layer, not the policy layer. The policy is clear. The approval chain is defined. But requests sit unreviewed because the approver wasn't notified. Or the wrong person approved. Or the PO was never generated because someone forgot. The compliance problem is a coordination problem.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>Structured intake form in SharePoint — required fields enforced, no incomplete submissions</li>
                  <li>Routing logic based on value threshold and category — no manual assignment</li>
                  <li>Approver notified immediately on receipt — not on a daily digest</li>
                  <li>Reminder and escalation built in — defined SLAs, automatic progression if no response</li>
                  <li>Approval captured in Dataverse — email reply is not a valid approval mechanism</li>
                  <li>PO generated automatically on final approval — from the structured intake data, not from manual entry</li>
                  <li>Supplier notification triggered on PO generation — without a person sending it</li>
                  <li>Full audit trail from request to PO — every decision, every approver, every timestamp</li>
                </ul>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your procurement process is policy-compliant in theory but coordination-dependent in practice — and that dependence creates delays, errors, or audit findings — this removes the coordination dependency. The process runs on logic. The humans provide the decisions.</p>
              </div>
            </div>
          </div>

          <div class="cs-item">
            <div class="cs-card">
              <span class="cs-eyebrow">Pattern 08 · Project Operations</span>
              <h3 class="cs-headline">Project status that updates itself and surfaces what's at risk</h3>
              <p class="cs-synopsis">Status tracking automated from task data — progress calculated, risks identified, and stakeholders updated without a status meeting.</p>
              <div class="cs-tags">
                <span class="cs-tag">Planner</span>
                <span class="cs-tag">Power Automate</span>
                <span class="cs-tag">SharePoint</span>
                <span class="cs-tag">Teams</span>
                <span class="cs-tag">Outlook</span>
              </div>
              <button class="cs-toggle">Read the full case →</button>
            </div>
            <div class="cs-detail">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Problem</span>
                <p>Project status reporting in an enterprise consumes a disproportionate amount of time relative to its value. Someone aggregates updates from multiple owners. Someone formats them. Someone sends them. The report reflects the state of the project as of the last time someone chased for an update — which is not the same as the current state.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">What We Built</span>
                <ul>
                  <li>Task completion data pulled from Planner automatically — no manual update required from task owners</li>
                  <li>Progress calculated at project and workstream level — percentages derived from data, not estimates</li>
                  <li>Schedule variance calculated — tasks behind schedule identified by day, not by human review</li>
                  <li>Risk flag triggered automatically when variance exceeds threshold — not at the next status meeting</li>
                  <li>Status report generated from live data on a schedule — distributed to stakeholders without a person assembling it</li>
                  <li>Executive summary generated by AI — narrative written from structured data, not by the project manager</li>
                  <li>Escalation triggered for items at risk of missing milestone — the right person is notified before the milestone is missed</li>
                </ul>
                <p class="cs-pull">A status report that is accurate as of last Friday is not a status report. It's a history. Project intelligence has to be live.</p>
              </div>
              <hr class="cs-divider">
              <div class="cs-detail-section">
                <span class="cs-section-label">The Result</span>
                <p>If your project reporting cycle requires manual aggregation from multiple owners — and the report is out of date by the time it's distributed — this makes the reporting continuous and automatic. The project manager's time goes to decisions and stakeholder management, not to data aggregation.</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Pull quote -->
    <section class="section">
      <div class="container" style="text-align: center;">
        <blockquote class="pull-quote">
          The best enterprise automation is invisible to the user and undeniable to the auditor. Everything else is a demo.
        </blockquote>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="section section-alt">
      <div class="container section-numbered" data-section-num="02">
        <div class="section-header">
          <span class="eyebrow">Capability reference</span>
          <h2>What we build with</h2>
          <p>Seven core capabilities across the Microsoft 365 platform. Each is a reusable pattern, not a custom integration built from scratch every engagement.</p>
        </div>
        <div class="caps-grid">
          {capabilities.map(cap => (
            <CapabilityCard title={cap.title} description={cap.description} />
          ))}
        </div>
        <p class="section-link">Our <a href="/how-we-work">three-phase methodology</a> explains how every pattern gets from prototype to production.</p>
      </div>
    </section>

    <!-- Stack -->
    <section class="section">
      <div class="container section-numbered" data-section-num="03">
        <div class="section-header">
          <span class="eyebrow">Architecture</span>
          <h2>The stack</h2>
          <p>Everything runs inside your existing Microsoft 365 licence. No new vendors to onboard. No data leaving the tenant. Your IT team governs it the same way they govern the rest of M365.</p>
        </div>
        <div class="stack-row">
          <StackBadge name="Copilot Studio" />
          <StackBadge name="Power Automate" />
          <StackBadge name="AI Builder" />
          <StackBadge name="SharePoint" />
          <StackBadge name="Outlook / Teams" />
          <StackBadge name="Excel / Dataverse" />
        </div>
      </div>
    </section>

    <!-- Bottom 4 action cards -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">What's next</span>
        <h2>Where would you like to go?</h2>
        <div class="quad-grid">
          <a href="/contact#contact-form-section" class="action-card">
            <span class="action-card-label">Get started</span>
            <h3>Start a conversation</h3>
            <p>Tell us the M365 workflow you want to automate. We'll scope it and tell you how we'd build it inside your tenant. No commitment required.</p>
            <span class="action-card-cta">Start a conversation →</span>
          </a>
          <a href="/enterprise" class="action-card">
            <span class="action-card-label">In practice</span>
            <h3>Case studies</h3>
            <p>Eight enterprise automation patterns. Email triage, document intelligence, compliance monitoring, procurement, project operations — all inside M365.</p>
            <span class="action-card-cta">View all patterns →</span>
          </a>
          <a href="/enterprise" class="action-card">
            <span class="action-card-label">The stack</span>
            <h3>Tools we use</h3>
            <p>Copilot Studio, Power Automate, AI Builder, SharePoint, Teams, and Dataverse. Everything runs inside your existing M365 licence. Nothing leaves the tenant.</p>
            <span class="action-card-cta">See the full stack →</span>
          </a>
          <a href="https://calendly.com/hrsrini/i-need-to-know-more-about-automation" target="_blank" rel="noopener noreferrer" class="action-card">
            <span class="action-card-label">Book time</span>
            <h3>Schedule a call</h3>
            <p>Ready to scope your enterprise automation? We'll walk through the workflow and tell you exactly what a prototype would look like inside your tenant.</p>
            <span class="action-card-cta">Schedule a call →</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.querySelectorAll('.cs-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const detail = btn.closest('.cs-item').querySelector('.cs-detail');
        if (!detail) return;
        const isOpen = detail.classList.contains('open');
        detail.classList.toggle('open', !isOpen);
        btn.textContent = isOpen ? 'Read the full case →' : 'Close ↑';
      });
    });
  </script>

  <Footer />
</Base>
