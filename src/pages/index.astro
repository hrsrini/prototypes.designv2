---
export const prerender = true;
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
---

<Base fullTitle="AI-Led Automation Consulting | Google Workspace & Microsoft 365 | prototypes.design" title="Home" description="AI-led automation consulting for Google Workspace and Microsoft 365. Every workflow deserves a prototype first. Ours ship.">
  <script slot="head" type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "prototypes.design",
    "url": "https://prototypes.design",
    "description": "AI-led automation consulting for Google Workspace and Microsoft 365. We prototype workflows that ship.",
    "serviceType": "AI Automation Consulting",
    "areaServed": "Worldwide",
    "email": "prototypenow@prototypes.design"
  })}</script>
  <NavBar path="/" />

  <main>
    <!-- Hero -->
    <section class="hero" style="background: var(--bg-page);">
      <div class="container">
        <span class="eyebrow">prototypes.design · AI-led automation consulting</span>
        <h1>AI-led automation consulting for <em>Google Workspace</em> and <em>Microsoft 365</em></h1>
        <p class="hero-sub">Every workflow deserves a prototype first. <em>Ours ship.</em> Deliberately designed, not patched together — inside the tools you already use.</p>
        <div class="hero-actions">
          <a href="/smb" class="btn btn-primary">For Google Workspace →</a>
          <a href="/enterprise" class="btn btn-outline">For Microsoft 365 →</a>
          <a href="/contact#contact-form-section" class="btn btn-outline">Get in touch →</a>
          <a href="https://calendly.com/hrsrini/i-need-to-know-more-about-automation" class="btn btn-dark">Book a meeting →</a>
        </div>
      </div>
    </section>

    <!-- Two-track section -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">Two platforms. One approach.</span>
        <h2>Where do you work?</h2>
        <div class="track-grid">
          <a href="/smb" class="track-card">
            <span class="track-card-label">Google Workspace · For SMBs</span>
            <h3>For growing teams</h3>
            <p>We build automation natively inside Google Sheets, Drive, Gmail, and Apps Script. No new platforms. No middleware. Eight production patterns, all industry-agnostic.</p>
            <div class="track-card-tools">
              <span class="tool-tag">Google Sheets</span>
              <span class="tool-tag">Google Drive</span>
              <span class="tool-tag">Gmail</span>
              <span class="tool-tag">Apps Script</span>
              <span class="tool-tag">Claude API</span>
            </div>
            <div class="track-card-cta">Explore Google Workspace patterns →</div>
          </a>
          <a href="/enterprise" class="track-card">
            <span class="track-card-label">Microsoft 365 · For Enterprise</span>
            <h3>For enterprise workflows</h3>
            <p>We build automation inside your existing Microsoft 365 tenant — Copilot Studio, Power Automate, AI Builder. No shadow IT. No new vendors. Eight production patterns, all inside your existing licence.</p>
            <div class="track-card-tools">
              <span class="tool-tag">Copilot Studio</span>
              <span class="tool-tag">Power Automate</span>
              <span class="tool-tag">AI Builder</span>
              <span class="tool-tag">SharePoint</span>
              <span class="tool-tag">Outlook</span>
            </div>
            <div class="track-card-cta">Explore enterprise patterns →</div>
          </a>
        </div>
      </div>
    </section>

    <!-- Pull quote -->
    <section class="section section-alt">
      <div class="container" style="text-align: center;">
        <blockquote class="pull-quote">
          Any organisation with more than a few moving parts has automation debt. The question is whether that debt is managed or hidden.
        </blockquote>
      </div>
    </section>

    <!-- How we work summary -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">The method</span>
        <h2 style="margin-bottom: var(--space-lg);">How we work</h2>
        <div class="steps-row">
          <div class="step">
            <span class="step-num">01</span>
            <h3>Understand</h3>
            <p>We map the workflow as it exists today — where handoffs break, where humans compensate for missing logic, where the highest value automation sits.</p>
          </div>
          <div class="step">
            <span class="step-num">02</span>
            <h3>Prototype</h3>
            <p>A working automation inside your existing environment. Not a demo. Real edge cases, real data, the architecture that will scale. You see it run before we spend a day on production hardening.</p>
          </div>
          <div class="step">
            <span class="step-num">03</span>
            <h3>Ship</h3>
            <p>Audit logs, error handling, documentation, handoff to your team. An automation you will never have to touch unless the business changes.</p>
          </div>
        </div>
        <div style="margin-top: var(--space-xl);">
          <a href="/how-we-work" class="btn btn-outline">See the full methodology →</a>
        </div>
      </div>
    </section>

    <!-- CTA band -->
    <section class="section" style="padding: 0;">
      <div class="container">
        <p class="cs-nda home-nda">Every case on this site reflects a live build. References available under NDA.</p>
        <div class="cta-band" style="padding: 2.5rem var(--space-xl);">
          <h2>Ready to start with a prototype?</h2>
          <p>Tell us the workflow. We'll scope phase one and show you what a working prototype would look like.</p>
          <div class="cta-band-actions">
            <a href="/contact" class="btn btn-cta-solid">Get in touch →</a>
            <a href="https://calendly.com/hrsrini/i-need-to-know-more-about-automation" target="_blank" rel="noopener" class="btn btn-cta-outline">Book a meeting →</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
